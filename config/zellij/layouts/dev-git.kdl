// dev-git layout: yazi (left) + kiro (right-top) + terminal (right-bottom-left) + lazygit (right-bottom-right)
layout {
    pane split_direction="vertical" {
        pane size="20%" command="yazi"
        pane split_direction="horizontal" {
            pane size="60%" command="kiro-cli" {
                args "chat"
            }
            pane size="40%" split_direction="vertical" {
                pane size="67%"
                pane size="33%" command="lazygit"
            }
        }
    }
}
