// dev-git-kiro layout: yazi (left) + kiro (right-top) + terminal (right-bottom-left) + lazygit (right-bottom-right)
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
    }

    tab name="dev" {
        pane split_direction="vertical" {
            pane size="15%" command="yazi"
            pane split_direction="horizontal" {
                pane size="60%" command="kiro-cli" focus=true {
                    args "chat"
                }
                pane size="40%" split_direction="vertical" {
                    pane size="50%"
                    pane size="50%" command="lazygit"
                }
            }
        }
    }
}
