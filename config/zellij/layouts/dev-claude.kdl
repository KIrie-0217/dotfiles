// dev-claude layout: yazi (left) + claude (right-top) + terminal (right-bottom)
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
    }

    tab name="dev" {
        pane split_direction="vertical" {
            pane size="15%" command="yazi"
            pane split_direction="horizontal" {
                pane size="60%" command="claude" focus=true
                pane size="40%"
            }
        }
    }
}
