#!/usr/bin/env bash
# zj - zellij launcher with git-aware layout selection
#
# Usage:
#   zj              Start zellij with claude (default)
#   zj kiro         Start zellij with kiro-cli chat
#   zj claude       Start zellij with claude
#   zj <args...>    Pass arguments directly to zellij

ai="claude"

case "${1:-}" in
  kiro)   ai="kiro"; shift ;;
  claude) ai="claude"; shift ;;
esac

if [ $# -gt 0 ]; then
  exec zellij "$@"
fi

if [ -d .git ] || git rev-parse --git-dir &>/dev/null; then
  exec zellij --layout "dev-git-${ai}"
else
  exec zellij --layout "dev-${ai}"
fi
