#!/usr/bin/env bash
# zj - zellij launcher with git-aware layout selection
#
# Usage:
#   zj              Start zellij with claude (default)
#   zj kiro         Start zellij with kiro-cli chat
#   zj claude       Start zellij with claude
#   zj <args...>    Pass arguments directly to zellij

ai="claude"

case "${1:-}" in
  kiro)   ai="kiro"; shift ;;
  claude) ai="claude"; shift ;;
esac

if [ $# -gt 0 ]; then
  exec zellij "$@"
fi

if [ -d .git ] || git rev-parse --git-dir &>/dev/null; then
  layout_name="dev-git-${ai}"
else
  layout_name="dev-${ai}"
fi

# Replace tab name with current directory name
tab_name=$(basename "$PWD")
layout_dir="${XDG_CONFIG_HOME:-$HOME/.config}/zellij/layouts"
tmp_layout="$(mktemp /tmp/zj-layout-XXXXXX).kdl"
sed "s/tab name=\"dev\"/tab name=\"${tab_name}\"/" "$layout_dir/${layout_name}.kdl" > "$tmp_layout"

exec zellij --layout "$tmp_layout"
