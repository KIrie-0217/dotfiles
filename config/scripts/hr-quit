#!/usr/bin/env bash
# hr-quit - close current workspace and detach from herdr
set -euo pipefail

# Get current workspace ID
current_ws=$(herdr pane current 2>/dev/null | jq -r '.result.workspace_id // empty')

if [ -n "$current_ws" ]; then
  herdr workspace close "$current_ws" 2>/dev/null || true
fi

# If no workspaces remain, stop server; otherwise just detach
remaining=$(herdr workspace list 2>/dev/null | jq -r '.result.workspaces | length // 0')

if [ "$remaining" = "0" ] || [ -z "$remaining" ]; then
  herdr server stop 2>/dev/null || true
fi
